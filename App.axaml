<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DocxAvalonia.App"
             xmlns:local="using:DocxAvalonia"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DocxAvalonia/Styles/DocxPreviewStyles.axaml" />
    </Application.Styles>
</Application>
