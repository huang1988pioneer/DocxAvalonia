<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Document helpers -->
    <Style Selector="Border.docx-page">
        <Setter Property="Background" Value="White" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #28000000" />
        <Setter Property="Padding" Value="80,64" />
        <Setter Property="Margin" Value="40,28" />
        <Setter Property="MinWidth" Value="700" />
        <Setter Property="MaxWidth" Value="820" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.docx-heading1">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,16,0,10" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.docx-heading2">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,14,0,8" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.docx-heading3">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,6" />
        <Setter Property="Foreground" Value="#2C3A4A" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.docx-paragraph">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.docx-list-item">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Margin" Value="24,0,0,6" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.docx-table">
        <Setter Property="BorderBrush" Value="#C5CDD8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,8,0,16" />
    </Style>

    <Style Selector="Border.docx-table-cell">
        <Setter Property="BorderBrush" Value="#DCE2EA" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style Selector="Border.docx-table-header-cell">
        <Setter Property="BorderBrush" Value="#C5CDD8" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="#F0F5F9" />
    </Style>

    <Style Selector="Image.docx-image">
        <Setter Property="Margin" Value="0,8,0,12" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- Image free-resize handles (8 directions) -->
    <Style Selector="Border.img-handle">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="ZIndex" Value="20" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border.img-handle:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="BorderBrush" Value="#0078A8" />
    </Style>

    <!-- Table edge add-cell buttons -->
    <Style Selector="Button.table-edge-btn">
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#0078A8" />
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="BorderBrush" Value="#B3E5F5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="Button.table-edge-btn:pointerover">
        <Setter Property="Background" Value="#D0F0FA" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
    </Style>
    <Style Selector="Button.table-edge-btn-v">
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#0078A8" />
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="BorderBrush" Value="#B3E5F5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinWidth" Value="28" />
    </Style>
    <Style Selector="Button.table-edge-btn-v:pointerover">
        <Setter Property="Background" Value="#D0F0FA" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
    </Style>

    <Style Selector="TextBlock.docx-empty">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#5A6A7A" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Margin" Value="32" />
    </Style>

    <!-- ═══ Zoho Writer chrome ═══ -->

    <Style Selector="Border.zoho-logo">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="#00A3E0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style Selector="TextBlock.zoho-logo-letter">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.zoho-status-pill">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BorderBrush" Value="#B3E5F5" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.zoho-primary">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Background" Value="#00A3E0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.zoho-primary:pointerover">
        <Setter Property="Background" Value="#0090C7" />
    </Style>

    <Style Selector="Button.zoho-primary:pressed">
        <Setter Property="Background" Value="#0078A8" />
    </Style>

    <Style Selector="Button.zoho-ghost">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="BorderBrush" Value="#C5CDD8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.zoho-ghost:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
        <Setter Property="Foreground" Value="#0078A8" />
    </Style>

    <Style Selector="Button.zoho-tab">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="#4A5A6A" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.zoho-tab:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="Foreground" Value="#00A3E0" />
    </Style>

    <Style Selector="Button.zoho-tab.active">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#00A3E0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
    </Style>

    <Style Selector="Button.zoho-tab.active:pointerover">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#00A3E0" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
    </Style>

    <Style Selector="Border.zoho-ribbon-body">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#E4E8EE" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="4,6,4,8" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style Selector="Border.zoho-group">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <Style Selector="TextBlock.zoho-group-label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#8A96A3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style Selector="Border.zoho-vsep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="#E0E5EC" />
        <Setter Property="Margin" Value="4,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="Button.zoho-tbtn">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.zoho-tbtn:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="BorderBrush" Value="#B3E5F5" />
        <Setter Property="Foreground" Value="#0078A8" />
    </Style>

    <Style Selector="Button.zoho-tbtn:pressed">
        <Setter Property="Background" Value="#D0EFFA" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
    </Style>

    <Style Selector="Button.zoho-tbtn-mini">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#4A5A6A" />
    </Style>

    <Style Selector="Button.zoho-tbtn-mini:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="Foreground" Value="#00A3E0" />
    </Style>

    <Style Selector="Border.zoho-statusbar">
        <Setter Property="Background" Value="#F4F6F8" />
        <Setter Property="BorderBrush" Value="#D5DBE3" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="TextBlock.zoho-status-text">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#3D4F63" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style Selector="Border.zoho-status-sep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="#C5CDD8" />
        <Setter Property="Margin" Value="8,4" />
    </Style>

    <Style Selector="Border.zoho-panel">
        <Setter Property="Background" Value="#F7F9FB" />
    </Style>

    <Style Selector="Border.zoho-panel-left">
        <Setter Property="BorderBrush" Value="#D5DBE3" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style Selector="Border.zoho-panel-right">
        <Setter Property="BorderBrush" Value="#D5DBE3" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>

    <Style Selector="Border.zoho-panel-header">
        <Setter Property="Background" Value="#EEF2F6" />
        <Setter Property="BorderBrush" Value="#D5DBE3" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="TextBlock.zoho-panel-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.zoho-section-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#00A3E0" />
        <Setter Property="Margin" Value="2,0,0,2" />
    </Style>

    <Style Selector="Border.zoho-card">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#DCE2EA" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="Button.zoho-nav-item">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="#1A2332" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.zoho-nav-item:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="Foreground" Value="#0078A8" />
    </Style>

    <Style Selector="TextBox.zoho-input">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="#C5CDD8" />
        <Setter Property="Background" Value="White" />
    </Style>

    <!-- ═══ Microsoft Word chrome ═══ -->
    <Style Selector="Button.word-qa">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="#3D6DB5" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.word-qa:pointerover">
        <Setter Property="Background" Value="#4A7BC8" />
    </Style>

    <!-- ═══ LibreOffice chrome ═══ -->
    <Style Selector="Button.lo-btn">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="#E8E8E8" />
        <Setter Property="Foreground" Value="#222" />
        <Setter Property="BorderBrush" Value="#B0B0B0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.lo-btn:pointerover">
        <Setter Property="Background" Value="#D8F5D0" />
        <Setter Property="BorderBrush" Value="#18A303" />
    </Style>

    <!-- ═══ Google Docs chrome ═══ -->
    <Style Selector="Button.gdocs-primary">
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Background" Value="#1A73E8" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.gdocs-primary:pointerover">
        <Setter Property="Background" Value="#1765CC" />
    </Style>
    <Style Selector="Button.gdocs-ghost">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#1A73E8" />
        <Setter Property="BorderBrush" Value="#DADCE0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.gdocs-ghost:pointerover">
        <Setter Property="Background" Value="#E8F0FE" />
    </Style>

    <!-- ═══ WPS Writer chrome ═══ -->
    <Style Selector="Button.wps-primary">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.wps-primary:pointerover">
        <Setter Property="Background" Value="#C40E1C" />
    </Style>
    <Style Selector="Button.wps-ghost">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#333" />
        <Setter Property="BorderBrush" Value="#D0D0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.wps-ghost:pointerover">
        <Setter Property="Background" Value="#FFF0F0" />
        <Setter Property="BorderBrush" Value="#E81123" />
        <Setter Property="Foreground" Value="#E81123" />
    </Style>

    <!-- ═══ FreeOffice TextMaker chrome ═══ -->
    <Style Selector="Button.fo-btn">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="#F5F0E6" />
        <Setter Property="Foreground" Value="#3A3020" />
        <Setter Property="BorderBrush" Value="#C8B898" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.fo-btn:pointerover">
        <Setter Property="Background" Value="#FFE4C4" />
        <Setter Property="BorderBrush" Value="#E36C0A" />
    </Style>

    <!-- Legacy aliases -->
    <Style Selector="Border.ribbon-group">
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="Border.ribbon-sep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="#E0E5EC" />
        <Setter Property="Margin" Value="4,8" />
    </Style>

    <Style Selector="Button.ribbon-btn">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="#1A2332" />
    </Style>

    <Style Selector="Button.ribbon-btn:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
        <Setter Property="BorderBrush" Value="#B3E5F5" />
    </Style>

    <Style Selector="TextBlock.ribbon-label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#8A96A3" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.ribbon-tab">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#4A5A6A" />
    </Style>

    <Style Selector="Button.ribbon-tab.active">
        <Setter Property="Foreground" Value="#00A3E0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="#00A3E0" />
    </Style>

    <Style Selector="Button.qa-btn">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="#00A3E0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.tb-btn">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.tb-btn:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
    </Style>

    <Style Selector="Button.tb-btn-mini">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.gdocs-tbtn">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="#1A2332" />
    </Style>

    <Style Selector="Button.gdocs-tbtn:pointerover">
        <Setter Property="Background" Value="#E8F7FC" />
    </Style>

    <Style Selector="Button.gdocs-share-btn">
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Background" Value="#00A3E0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.gdocs-ghost-btn">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#C5CDD8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Menu.lo-menu">
        <Setter Property="Background" Value="White" />
    </Style>

    <Style Selector="Border.lo-toolbar">
        <Setter Property="Background" Value="White" />
    </Style>

    <Style Selector="Border.lo-statusbar">
        <Setter Property="Background" Value="#F4F6F8" />
    </Style>

    <Style Selector="Border.lo-sidebar">
        <Setter Property="Background" Value="#F7F9FB" />
    </Style>

    <Style Selector="Border.lo-card">
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="#DCE2EA" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBlock.lo-card-title">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#00A3E0" />
    </Style>

</Styles>
